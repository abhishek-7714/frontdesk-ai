# Required
DATABASE_URL=postgres://user:password@host:5432/frontdesk   # Postgres 16 with the pgvector extension

# Voice (ElevenLabs). /api/eleven/session returns 503 until both are set.
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=          # written to .env.local by `npx tsx scripts/create-eleven-agent.ts`

# Optional upgrades (the app degrades gracefully without them)
OPENAI_API_KEY=               # policy embeddings; without it, Postgres full-text search is used
ANTHROPIC_API_KEY=            # LLM call summaries; without it, a template summary is used

# Secrets for the doctor-facing MCP server and the admin reset (generate with: openssl rand -hex 24)
MCP_SECRET=
ADMIN_TOKEN=

# Defaults shown
DEMO_DOCTOR_SLUG=meera-iyer
CLINIC_TZ=Asia/Kolkata
NEXT_PUBLIC_CLINIC_NAME=Fernleaf Clinic
